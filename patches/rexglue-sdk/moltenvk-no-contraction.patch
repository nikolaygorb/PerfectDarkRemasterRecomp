diff --git a/include/rex/graphics/pipeline/shader/spirv_builder.h b/include/rex/graphics/pipeline/shader/spirv_builder.h
index 0dd11c3..ef0bc83 100644
--- a/include/rex/graphics/pipeline/shader/spirv_builder.h
+++ b/include/rex/graphics/pipeline/shader/spirv_builder.h
@@ -38,6 +38,13 @@ class SpirvBuilder : public spv::Builder {
   spv::Id createNoContractionBinOp(spv::Op op_code, spv::Id type_id, spv::Id operand1,
                                    spv::Id operand2);
 
+  // Whether createNoContraction*Op decorate their results with NoContraction.
+  // SPIRV-Cross turns NoContraction arithmetic into calls to [[clang::optnone]]
+  // functions, which Apple GPUs evaluate incorrectly in the helper lanes of
+  // multisampled draws, so derivatives of their results are garbage at
+  // triangle edges.
+  void setNoContraction(bool no_contraction) { no_contraction_ = no_contraction; }
+
   spv::Id createUnaryBuiltinCall(spv::Id result_type, spv::Id builtins, int entry_point,
                                  spv::Id operand);
   spv::Id createBinBuiltinCall(spv::Id result_type, spv::Id builtins, int entry_point,
@@ -145,6 +152,9 @@ class SpirvBuilder : public spv::Builder {
 
     Branch current_branch_ = Branch::kSelection;
   };
+
+ private:
+  bool no_contraction_ = true;
 };
 
 }  // namespace rex::graphics
